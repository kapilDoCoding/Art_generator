#include <iostream>
#include <fstream>
#include <cctype>
#include <unordered_set>

using namespace std;

// Set of C++ keywords
unordered_set<string> keywords = {
    "int", "float", "return", "if", "else", "while", "for", "do", "switch",
    "case", "break", "continue", "void", "char", "double", "long", "short",
    "signed", "unsigned", "const", "static", "struct", "typedef", "union",
    "enum", "extern", "goto", "default", "sizeof", "volatile", "register"
};

// Function to check if a word is a keyword
bool isKeyword(const string &word) {
    return keywords.find(word) != keywords.end();
}

// Function to classify and print tokens
void tokenize(string input) {
    int length = input.length();
    int i = 0;

    while (i < length) {
        // Handle whitespace and special characters
        if (isspace(input[i])) {
            if (input[i] == ' ') {
                cout << "Whitespace: ' '\n";
            } else if (input[i] == '\t') {
                cout << "Tab: '\\t'\n";
            } else if (input[i] == '\n') {
                cout << "Newline: '\\n'\n";
            }
            i++;
        }
        // Handle identifiers and keywords
        else if (isalpha(input[i]) || input[i] == '_') {
            string word;
            while (i < length && (isalnum(input[i]) || input[i] == '_')) {
                word += input[i];
                i++;
            }
            if (isKeyword(word)) {
                cout << "Keyword: " << word << "\n";
            } else {
                cout << "Identifier: " << word << "\n";
            }
        }
        // Handle numbers (ignore actual number parsing for now)
        else if (isdigit(input[i])) {
            string number;
            while (i < length && isdigit(input[i])) {
                number += input[i];
                i++;
            }
            cout << "Number: " << number << "\n";
        }
        // Handle single characters like `+`, `-`, `*`, `/`, etc.
        else {
            cout << "Character: '" << input[i] << "'\n";
            i++;
        }
    }
}

int main() {
    string input;
    cout << "Enter code to tokenize (Ctrl+D to end input):\n";
    string line;

    // Read input till EOF
    while (getline(cin, line)) {
        input += line + '\n';
    }

    cout << "\nTokenized Output:\n";
    tokenize(input);

    return 0;
}
